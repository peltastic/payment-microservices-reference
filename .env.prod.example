# Required by docker-compose.prod.yml.
# Generate unique values per environment; do not commit a real .env.prod file.
# Secrets should be unique per environment and at least 32 characters.

DB_USER=payment_reference
DB_PASSWORD=
DB_SSLMODE=disable

REDIS_PASSWORD=
INTERNAL_AUTH_SECRET=
EVENT_SIGNING_SECRET=
# Use a 32-byte key encoded as 64 hex characters or base64.
WEBHOOK_SECRET_ENCRYPTION_KEY=
GRAFANA_PASSWORD=

# The bank provider is intentionally mocked for this teaching project.
BANK_MOCK_URL=http://bank-mock:5001
