# Local development defaults for docker-compose.yml.
# These are local-only sample values; generate unique secrets for any shared environment.

DB_USER=payment_reference
DB_PASSWORD=payment_reference
DB_SSLMODE=disable

INTERNAL_AUTH_SECRET=local-dev-internal-auth-secret-32chars-min
EVENT_SIGNING_SECRET=local-dev-event-signing-secret-32chars-min
WEBHOOK_SECRET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

AUTH_SERVICE_URL=http://auth:4001/api/v1/auth
PAYMENT_SERVICE_URL=http://payment:4002
LEDGER_SERVICE_URL=http://ledger:4003
WEBHOOK_SERVICE_URL=http://webhook:4004
BANK_MOCK_URL=http://bank-mock:5001

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
LOADTEST_RATE_LIMIT_MAX=5000
GRAFANA_PASSWORD=payment_reference
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
