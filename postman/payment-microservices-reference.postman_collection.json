          "name": "Ledger Service - localhost:4003",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const internalSecret = pm.collectionVariables.get('internal_secret') || pm.environment.get('internal_secret');",
                  "if (!internalSecret) {",
                  "  throw new Error('Set collection variable internal_secret before calling direct internal service routes.');",
                  "}",
                  "function headerValue(name) {",
                  "  const raw = pm.request.headers.get(name);",
                  "  return raw ? pm.variables.replaceIn(raw) : '';",
                  "}",
                  "let requestId = headerValue('x-request-id');",
                  "if (!requestId) {",
                  "  requestId = `req_${Date.now()}_${Math.floor(Math.random() * 1000000)}`;",
                  "}",
                  "pm.request.headers.upsert({ key: 'x-request-id', value: requestId });",
                  "const merchantId = headerValue('x-merchant-id');",
                  "const fullUrl = pm.variables.replaceIn(pm.request.url.toString());",
                  "const parsedUrl = new URL(fullUrl);",
                  "const pathWithQuery = parsedUrl.pathname + parsedUrl.search;",
                  "const timestamp = Math.floor(Date.now() / 1000).toString();",
                  "const rawBody = pm.request.body && pm.request.body.raw ? pm.variables.replaceIn(pm.request.body.raw) : '';",
                  "const bodyHash = CryptoJS.SHA256(rawBody).toString(CryptoJS.enc.Hex);",
                  "const canonical = [pm.request.method.toUpperCase(), pathWithQuery, timestamp, requestId, merchantId, bodyHash].join('\\n');",
                  "const signature = CryptoJS.HmacSHA256(canonical, internalSecret).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: 'x-internal-timestamp', value: timestamp });",
                  "pm.request.headers.upsert({ key: 'x-internal-body-sha256', value: bodyHash });",
                  "pm.request.headers.upsert({ key: 'x-internal-signature', value: signature });"
                ]
              }
            }
