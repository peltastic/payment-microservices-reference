        {
          "name": "Auth",
          "item": [
            {
              "name": "Create API Key",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{gateway_base_url}}/v1/auth/keys/",
                "description": "Requires the current {{api_key}} to have full, admin, or auth:write scope.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"merchant_name\": \"Acme Stores\",\n  \"merchant_email\": \"ops+{{$timestamp}}@acme.example\",\n  \"scope\": \"full\",\n  \"expires_at\": \"2027-12-31T23:59:59Z\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('response status is 201', function () { pm.expect(pm.response.code).to.equal(201); });",
                      "const body = pm.response.json();",
                      "if (body.api_key) { pm.collectionVariables.set('api_key', body.api_key); }"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Validate API Key",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{gateway_base_url}}/v1/auth/internal/validate",
                "description": "Validates api_key through the gateway. The gateway itself still requires a bearer key with auth:write/full/admin scope.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"api_key\": \"{{api_key}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('response status is 200', function () { pm.expect(pm.response.code).to.equal(200); });",
                      "const body = pm.response.json();",
                      "const merchantId = body.merchant_id || body.MerchantID;",
                      "const scope = body.scope || body.Scope;",
                      "if (merchantId) { pm.collectionVariables.set('merchant_id', merchantId); }",
                      "if (scope) { pm.collectionVariables.set('merchant_scope', scope); }"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Revoke API Key",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
